{
	"name": "idk-yet-one-more",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"optimize-images": "image-transmutation --run --sourceFolder \"static/images\" --targetFolder \"static/optimized-images\" --inputFormats jpg --inputFormats jpeg --inputFormats png --outputFormats png --outputFormats webp --outputFormats avif --widths 400 --widths 800 --widths 1200 --widths 1600",
		"optimize-images-cloudflare": "image-transmutation --run --sourceFolder \"./.svelte-kit/cloudflare/images\" --targetFolder \"./.svelte-kit/cloudflare/optimized-images\" --inputFormats jpg --inputFormats jpeg --inputFormats png --outputFormats png --outputFormats webp --outputFormats avif --widths 400 --widths 800 --widths 1200 --widths 1600",
		"postbuild": "bun run optimize-images-cloudflare"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.1.2",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.3.5",
		"@storybook/addon-docs": "^10.3.5",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.3.5",
		"@storybook/sveltekit": "^10.3.5",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.5",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.3.5",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"image-transmutation": "^1.1.1",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"sass-embedded": "^1.99.0",
		"storybook": "^10.3.5",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-sitemap": "^3.1.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.5",
		"wrangler": "^4.81.0"
	},
	"dependencies": {
		"@directus/sdk": "^21.2.2",
		"@fontsource-variable/eb-garamond": "^5.2.7",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/instrument-serif": "^5.2.8",
		"@humanspeak/svelte-markdown": "^1.4.1",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@lucide/svelte": "^1.11.0",
		"marked": "^18.0.2",
		"svelte-sonner": "^1.1.1"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"esbuild",
		"sharp",
		"workerd"
	]
}
