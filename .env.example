# Development variables for setting your own Postgres and Directus instance

POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus
DIRECTUS_SECRET_KEY=this_is_not_secure_change_in_production
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=admin

# SvelteKit → Directus connection (server-side only)
PUBLIC_DIRECTUS_URL=http://localhost:8055

# Public URL for your frontend
PUBLIC_BASE_URL=http://localhost:5173

# Token for accessing the Directus API
# Recommended to create a seperate user for all API actions.
DIRECTUS_TOKEN=

# Secret token for Directus Live Preview — must match the token configured in Directus Settings → Live Preview
PREVIEW_SECRET=
